    New["October 9 paced PCM"] --> Final["Last nonempty final"]
    Clean["Clean speech-end marker"] --> Lag["Final minus speech end"]
    Final --> Lag
    Device["Device delivery"] -.-> Queue["Transport queue"]
    Queue -.-> ASR["ASR processing"]
    ASR -.-> UI["WPF rendering"]
