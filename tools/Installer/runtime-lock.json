  "excludedPackages": {
    "av": "The installed speech adapter only accepts in-memory PCM arrays. A disclosed faster-whisper patch makes optional file decoding fail explicitly without importing PyAV/FFmpeg."
  },
  "packagePatches": {
    "fasterWhisper": {
      "upstreamVersion": "1.2.1",
      "installedVersion": "1.2.1+phantomfudge1",
      "audioSha256": "60a1d8638f718cbf6d245aed3e5a5aa61c1f822a0b0fe9b48a7c928d47c23909",
      "padOrTrimSha256": "aa264b40d16df0ee7f0f9421ac5e8692ffb5c88f3c36e33c29bb3792f388cb08",
      "unchangedFiles": {
        "faster_whisper/transcribe.py": "5d5ffb00018561d3d529b2c72e1d9f5fff055bea725f3cccc7c6c67f5cc8ffe4",
        "faster_whisper/feature_extractor.py": "e403966dbc592a53695eea2aea24fa60bab50ef6755e0076b311f907be7a397c",
        "faster_whisper/vad.py": "37a9c774aefdd3162d936b896c8dcf5571b2ed938d65bffecfd631770049a18d",
        "faster_whisper/__init__.py": "5396c3a025a7b0cf81246fcd680c0bb7e384e2e587cc2e18f9518cef4c26d56c"
      },
      "change": "Only encoded-file decoding and its eager PyAV import are removed; ndarray transcription, feature extraction, VAD and pad_or_trim remain upstream source.",
      "reason": "Our production finalizer supplies NumPy PCM arrays. PyAV19's FFmpeg wheel includes unused x264/x265 components; its vendor patch moves them out of FFmpeg's GPL library classification. An LGPL-only label therefore does not establish redistribution compliance for that bundle. Excluding the unused decoder avoids shipping those unresolved codec components.",
      "licenseBoundary": "This is not a claim that PyAV can never be redistributed. An unchanged codec bundle would require its own complete component/source/license compliance review, which this release has not established. faster-whisper itself remains MIT; installed metadata deliberately describes a modified distribution, not an intact upstream dependency graph.",
      "evidence": [
        "https://raw.githubusercontent.com/PyAV-Org/pyav-ffmpeg/9.0.2-1/patches/ffmpeg.patch",
        "https://github.com/SYSTRAN/faster-whisper/blob/v1.2.1/faster_whisper/transcribe.py",
        "https://github.com/SYSTRAN/faster-whisper/blob/v1.2.1/LICENSE"
      ]
    }
  },
