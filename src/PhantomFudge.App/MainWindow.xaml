<Window x:Class="PhantomFudge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Phantom Fudge" Width="560" Height="760" MinWidth="410" MinHeight="520"
        WindowStyle="None" AllowsTransparency="False" ShowInTaskbar="False"
        Background="#FAF9F6" Foreground="#202B30" Topmost="True"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing" Closed="Window_Closed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#879A99" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="90" />
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="160" MinHeight="60" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Background="#DFE9E5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="13,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="Phantom Fudge  /  drag here" IsHitTestVisible="False" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2,5,2"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="ModeButton" Content="Present" Click="Mode_Click"
                            AutomationProperties.Name="Switch editing or presentation mode" />
                    <Button Content="Hide" Click="Hide_Click" AutomationProperties.Name="Hide window" />
                    <Button Content="X" Click="Exit_Click" AutomationProperties.Name="Exit application" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Margin="9,4">
                <WrapPanel x:Name="FileToolbar">
                    <Button Content="New" Click="New_Click" />
                    <Button Content="Open" Click="Open_Click" />
                    <Button Content="Save" Click="Save_Click" />
                    <Button Content="Save as" Click="SaveAs_Click" />
                    <Button Content="Find" Click="Find_Click" />
                    <Button Content="A-" Click="Smaller_Click" AutomationProperties.Name="Smaller note font" />
                    <Button Content="A+" Click="Larger_Click" AutomationProperties.Name="Larger note font" />
                    <CheckBox x:Name="WrapCheck" Content="Wrap" IsChecked="True"
                              VerticalAlignment="Center" Margin="6,0" Click="Wrap_Click" />
                </WrapPanel>
                <TextBlock x:Name="DocumentStatus" Text="Unsaved note  /  no automatic saving"
                           FontSize="11" Foreground="#536166" Margin="4,3" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="12,0">
                <StackPanel x:Name="FindPanel" Visibility="Collapsed" Orientation="Horizontal">
                    <TextBox x:Name="FindText" Width="230" Margin="0,4" Padding="5"
                             AutomationProperties.Name="Find in speaker notes" />
                    <Button Content="Next" Click="FindNext_Click" />
                    <Button Content="Close find" Click="CloseFind_Click" />
                </StackPanel>
                <Border x:Name="ConfirmPanel" Visibility="Collapsed" Background="#FFF0CA" Padding="8">
                    <StackPanel>
                        <TextBlock Text="There are unsaved notes or transcript text." TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Content="Save notes" Click="ConfirmSave_Click" />
                            <Button Content="Export transcript" Click="ConfirmExport_Click" />
                            <Button Content="Discard and continue" Click="ConfirmDiscard_Click" />
                            <Button Content="Cancel" Click="ConfirmCancel_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBox x:Name="NoteEditor" Grid.Row="3" Margin="12,3,12,7" Padding="9"
                     FontFamily="Consolas" FontSize="20" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="#FAF9F6"
                     UndoLimit="100" TextChanged="Note_TextChanged" DataObject.Pasting="Note_Pasting"
                     AutomationProperties.Name="Speaker notes" />
            <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch"
                          Background="#D7E1DC" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          Visibility="Collapsed" />
            <StackPanel Grid.Row="5" Margin="12,3,12,0">
                <DockPanel>
                    <TextBlock Text="LIVE MEETING TRANSCRIPT" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SourceButton" Content="Audio setup" Click="AudioSetup_Click" />
                        <Button x:Name="StartButton" Content="Start" Click="Start_Click" />
                        <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False" />
                        <Button x:Name="ExportButton" Content="Export" Click="Export_Click" />
                    </StackPanel>
                </DockPanel>
                <Border x:Name="AudioPanel" Visibility="Collapsed" Background="#EDF1ED" Padding="8">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Playback device (never microphone)" VerticalAlignment="Center" />
                            <Button Content="Refresh" Click="RefreshDevices_Click" HorizontalAlignment="Right" />
                        </DockPanel>
                        <ListBox x:Name="OutputDevices" DisplayMemberPath="Name" MaxHeight="70"
                                 AutomationProperties.Name="Playback output device" />
                        <TextBlock Text="All audio on this device is captured, including other apps or audible sidetone."
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4" />
                        <TextBlock Text="Local service token (session only)" FontSize="11" />
                        <PasswordBox x:Name="ServiceToken" Padding="4" Margin="0,3"
                                     AutomationProperties.Name="Local transcription service token" />
                        <CheckBox x:Name="ConsentCheck" Margin="0,4">
                            <TextBlock Text="I have permission to transcribe this meeting." TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="RehearsalCheck" Margin="0,4">
                            <TextBlock Text="I have checked this sharing setup with a separate recipient."
                                       TextWrapping="Wrap" />
                        </CheckBox>
                        <Button Content="Clear transcript" Click="ClearTranscript_Click"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <ProgressBar x:Name="AudioLevel" Minimum="0" Maximum="1" Height="3" Margin="0,3"
                             AutomationProperties.Name="Playback audio level, not microphone" />
                <TextBlock x:Name="AudioStatus" Text="Stopped. Local service only; raw audio is not saved."
                           FontSize="11" TextWrapping="Wrap" Margin="0,2" />
            </StackPanel>
            <Grid Grid.Row="6" Margin="12,4,12,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="TranscriptText" IsReadOnly="True" FontSize="14" BorderThickness="0"
                         Background="#F0F3EF" Padding="7" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Final live transcript" />
                <TextBlock x:Name="PartialText" Grid.Row="1" TextWrapping="Wrap" FontStyle="Italic"
                           Foreground="#52686A" MaxHeight="60" Margin="4,3"
                           AutomationProperties.Name="Unfinished recognition, may change" />
            </Grid>
            <StackPanel Grid.Row="7" Margin="12,1,12,8">
                <TextBlock x:Name="StatusText" Text="Initializing capture exclusion..."
                           FontSize="11" Foreground="#685837" TextWrapping="Wrap" />
                <TextBlock Text="Ctrl+Alt+Space: hide/reveal  /  Ctrl+Alt+E: edit  /  relaunch: recover"
                           FontSize="10" Foreground="#536166" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
