<Window x:Class="PhantomFudge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Phantom Fudge" Width="620" Height="760" MinWidth="470" MinHeight="560"
        WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        Background="Transparent" Foreground="{DynamicResource ThemeText}" Topmost="True"
        ShowActivated="False" Cursor="Arrow" ForceCursor="True"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing" Closed="Window_Closed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowSurface" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="100" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Background="{DynamicResource ThemeSurface}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="13,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeHeading}"
                           Text="Phantom Fudge" IsHitTestVisible="False" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2,5,2"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="ModeButton" Content="Edit" Click="Mode_Click"
                            AutomationProperties.Name="Switch editing or presentation mode" />
                    <Button Content="Hide" Click="Hide_Click" AutomationProperties.Name="Hide window" />
                    <Button Content="X" Click="Exit_Click" AutomationProperties.Name="Exit application" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource ThemeSurface}" Padding="10,5">
                <StackPanel>
                    <WrapPanel>
                        <Button x:Name="ThemeToggleButton" Click="ThemeToggle_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ThemeToggleIcon" FontFamily="Segoe UI Symbol"
                                           Text="&#x2600;" Margin="0,0,6,0" />
                                <TextBlock x:Name="ThemeToggleLabel" Text="Harbor Daylight" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlainThemeButton" Content="Plain B/W" Click="PlainTheme_Click" />
                        <TextBlock x:Name="ThemeName" VerticalAlignment="Center" Margin="9,0,0,0"
                                   Foreground="{DynamicResource ThemeMuted}" FontSize="11" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,5,0,1">
                    <TextBlock Text="Background" VerticalAlignment="Center" FontSize="11" />
                    <Slider x:Name="BackgroundOpacity" Minimum="10" Maximum="100" Value="55"
                            TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
                            Width="155" Margin="8,0" VerticalAlignment="Center"
                            ValueChanged="BackgroundOpacity_ValueChanged"
                            AutomationProperties.Name="Background opacity percent, lower means more transparent" />
                    <TextBlock Text="{Binding Value, ElementName=BackgroundOpacity, StringFormat={}{0:0}%}"
                               VerticalAlignment="Center" FontSize="11" Width="36" />
                    <TextBlock Text="lower = see through" VerticalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border x:Name="ConfirmPanel" Grid.Row="2" Margin="12,4" Visibility="Collapsed"
                    Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeWarning}"
                    BorderThickness="1" Padding="8">
                    <StackPanel>
                        <TextBlock Text="There are unsaved notes, transcript, or question text." TextWrapping="Wrap"
                                   Foreground="{DynamicResource ThemeWarning}" />
                        <TextBlock x:Name="ConfirmEditHint" Text="Use Edit to save/export. Copy question text before discarding it."
                                   TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" FontSize="11" />
                        <WrapPanel>
                            <Button Content="Save notes" Click="ConfirmSave_Click" />
                            <Button Content="Export transcript" Click="ConfirmExport_Click" />
                            <Button Content="Discard and continue" Click="ConfirmDiscard_Click" />
                            <Button Content="Cancel" Click="ConfirmCancel_Click" />
                        </WrapPanel>
                    </StackPanel>
            </Border>
            <StackPanel Grid.Row="3" Margin="12,8,12,0">
                <WrapPanel>
                    <TextBlock Text="LIVE TRANSCRIPT" FontSize="13" FontWeight="SemiBold" Margin="0,0,12,0"
                               Foreground="{DynamicResource ThemeHeading}"
                               VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <Button x:Name="StartButton" Content="Start" Click="Start_Click" />
                    <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False" />
                    <Button x:Name="SourceButton" Content="Audio setup" Click="AudioSetup_Click" />
                    <Button x:Name="ExportButton" Content="Export" Click="Export_Click" IsEnabled="False" />
                    <Button x:Name="QuestionToggleButton" Content="Question" Click="QuestionToggle_Click"
                            AutomationProperties.Name="Open or close the local question composer" />
                </WrapPanel>
                <WrapPanel x:Name="InputModeControls" Margin="0,3">
                    <TextBlock Text="Inputs:" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource ThemeMuted}" />
                    <Button x:Name="ComputerModeButton" Content="Computer" Click="ComputerMode_Click" />
                    <Button x:Name="MicrophoneModeButton" Content="Mic" Click="MicrophoneMode_Click" />
                    <Button x:Name="BothModeButton" Content="Both" Click="BothMode_Click" />
                    <TextBlock x:Name="InputModeLabel" Text="Computer + Mic" VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeHeading}" Margin="8,0,0,0" />
                </WrapPanel>
                <Border x:Name="AudioPanel" Visibility="Collapsed" Background="{DynamicResource ThemeSurface}"
                        BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Padding="8" Margin="0,4">
                    <ScrollViewer MaxHeight="185" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel x:Name="ComputerDeviceSection">
                        <DockPanel>
                            <TextBlock Text="Computer playback device" VerticalAlignment="Center" />
                            <Button Content="Refresh" Click="RefreshDevices_Click" HorizontalAlignment="Right" />
                        </DockPanel>
                        <ListBox x:Name="OutputDevices" DisplayMemberPath="Name" MaxHeight="70"
                                 PreviewMouseLeftButtonDown="OutputDevices_PreviewMouseLeftButtonDown"
                                 AutomationProperties.Name="Playback output device" />
                        </StackPanel>
                        <StackPanel x:Name="MicrophoneDeviceSection" Margin="0,5,0,0">
                            <DockPanel>
                                <TextBlock Text="Microphone for your dictated questions" VerticalAlignment="Center" />
                                <Button Content="Refresh" Click="RefreshDevices_Click" HorizontalAlignment="Right" />
                            </DockPanel>
                            <ListBox x:Name="MicrophoneDevices" DisplayMemberPath="Name" MaxHeight="60"
                                     PreviewMouseLeftButtonDown="OutputDevices_PreviewMouseLeftButtonDown"
                                     AutomationProperties.Name="Microphone input device" />
                        </StackPanel>
                        <TextBlock Text="Separate Computer/Mic tracks. Use headphones to reduce echo; no chat access."
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4"
                                   Foreground="{DynamicResource ThemeMuted}" />
                        <TextBlock Text="Computer input includes other apps/sidetone. Windows may show a microphone privacy indicator."
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4" />
                        <TextBlock Text="Local service token (session only)" FontSize="11" />
                        <PasswordBox x:Name="ServiceToken" Padding="4" Margin="0,3" IsEnabled="False"
                                     AutomationProperties.Name="Local transcription service token" />
                        <TextBlock x:Name="AudioEditHint" Text="Edit mode enables token entry and transcript export."
                                   FontSize="11" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" />
                        <Button Content="Clear transcript" Click="ClearTranscript_Click"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Computer" FontSize="10" Foreground="{DynamicResource ThemeMuted}" />
                        <ProgressBar x:Name="AudioLevel" Minimum="0" Maximum="1" Height="3"
                                     AutomationProperties.Name="Computer playback audio level" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Mic" FontSize="10" Foreground="{DynamicResource ThemeMuted}" />
                        <ProgressBar x:Name="MicrophoneLevel" Minimum="0" Maximum="1" Height="3"
                                     AutomationProperties.Name="Microphone dictation audio level" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="AudioStatus" Text="Stopped. Start explicitly to capture the selected inputs locally."
                           FontSize="11" TextWrapping="Wrap" Margin="0,3"
                           Foreground="{DynamicResource ThemeMuted}" />
            </StackPanel>
            <Grid x:Name="TranscriptArea" Grid.Row="4" Margin="12,7,12,8" SizeChanged="TranscriptArea_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="TranscriptText" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         Focusable="False" FontFamily="Segoe UI" FontSize="20" BorderThickness="0"
                         Background="Transparent" Padding="6" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Final live transcript" />
                <TextBlock x:Name="TranscriptPlaceholder" Text="Your meeting transcript will appear here."
                           Margin="6" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap"
                           IsHitTestVisible="False" />
                <TextBlock x:Name="PartialText" Grid.Row="1" TextWrapping="Wrap" FontStyle="Italic"
                           FontSize="18" Foreground="{DynamicResource ThemeHeading}" MaxHeight="75" Margin="6,5"
                           AutomationProperties.Name="Unfinished recognition, may change" />
                <Border x:Name="QuestionPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,6,0,0"
                        BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                        Background="{DynamicResource ThemeSurface}" Padding="7">
                    <ScrollViewer x:Name="QuestionScroll" MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                           <TextBlock Text="QUESTION AND ANSWER" FontWeight="SemiBold" Foreground="{DynamicResource ThemeHeading}" />
                           <TextBlock x:Name="AnswerProviderNotice" Text="Snapshot only: nothing is sent. Configure an answer provider to enable responses."
                                      FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" Margin="0,3" />
                           <WrapPanel>
                               <Button x:Name="AnswerSnapshotMode" Content="Snapshot only" Click="AnswerSnapshotMode_Click" />
                               <Button x:Name="AnswerConfiguredMode" Content="Use configured provider" Click="AnswerConfiguredMode_Click" />
                               <Button x:Name="AnswerReloadSettings" Content="Reload setup" Click="AnswerReloadSettings_Click" />
                           </WrapPanel>
                           <WrapPanel>
                               <Button x:Name="QuestionMicFilter" Content="Mic segments" Click="QuestionMicFilter_Click" />
                               <Button x:Name="QuestionComputerFilter" Content="Computer segments" Click="QuestionComputerFilter_Click" />
                               <Button x:Name="QuestionAllFilter" Content="All sources" Click="QuestionAllFilter_Click" />
                               <Button Content="Use selected" Click="UseQuestionSelection_Click" />
                           </WrapPanel>
                           <TextBlock Text="Select only the intended segments. Selection never starts recording."
                                      FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" />
                           <ListBox x:Name="QuestionSegments" Height="82" SelectionMode="Multiple"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    PreviewMouseLeftButtonDown="QuestionSegments_PreviewMouseLeftButtonDown"
                                    AutomationProperties.Name="Explicit question segment selection">
                               <ListBox.ItemTemplate>
                                   <DataTemplate>
                                       <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="12" />
                                   </DataTemplate>
                               </ListBox.ItemTemplate>
                           </ListBox>
                           <WrapPanel Margin="0,4,0,0">
                               <Button x:Name="QuestionEditButton" Content="Type / edit" Click="QuestionEdit_Click" />
                               <Button x:Name="QuestionAskButton" Content="Ask as shown" Click="QuestionAsk_Click" />
                               <Button x:Name="QuestionCopyButton" Content="Copy draft" Click="QuestionCopy_Click" />
                               <Button Content="Clear question" Click="QuestionClear_Click" />
                           </WrapPanel>
                           <TextBox x:Name="QuestionEditor" Height="78" Margin="0,4" Padding="5"
                                    AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                    IsReadOnly="True" Focusable="False" UndoLimit="50"
                                    TextChanged="QuestionEditor_TextChanged" DataObject.Pasting="QuestionEditor_Pasting"
                                    AutomationProperties.Name="Editable local question, maximum 8192 characters" />
                           <TextBlock x:Name="QuestionProvenance" FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource ThemeMuted}" />
                           <TextBlock x:Name="QuestionStatus" Text="Choose segments or use Type / edit."
                                      FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeHeading}" Margin="0,3" />
                           <StackPanel x:Name="QuestionSnapshotPanel" Visibility="Collapsed">
                               <TextBlock x:Name="QuestionSnapshotLabel" Text="Frozen snapshot - local only, not sent" FontSize="11"
                                          Foreground="{DynamicResource ThemeWarning}" />
                               <TextBox x:Name="QuestionSnapshotText" Height="65" IsReadOnly="True" Focusable="False"
                                        AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                        AutomationProperties.Name="Immutable local question snapshot" />
                           </StackPanel>
                           <StackPanel x:Name="AnswerPanel" Visibility="Collapsed" Margin="0,6,0,0">
                               <WrapPanel>
                                   <TextBlock Text="ANSWER" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                   <Button x:Name="AnswerCancelButton" Content="Cancel answer" Click="AnswerCancel_Click" />
                                   <Button x:Name="AnswerCopyButton" Content="Copy answer" Click="AnswerCopy_Click" />
                               </WrapPanel>
                               <TextBlock x:Name="AnswerRunLabel" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeMuted}" />
                               <TextBox x:Name="AnswerText" Height="150" IsReadOnly="True" Focusable="False"
                                        TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                        FontSize="16" Padding="5" Background="Transparent"
                                        AutomationProperties.Name="Provider answer, plain text" />
                               <TextBlock x:Name="AnswerStatus" TextWrapping="Wrap" FontSize="11"
                                          Foreground="{DynamicResource ThemeWarning}" Margin="0,3" />
                           </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Border Grid.Row="5" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource ThemeSurface}" Padding="9,3">
                <DockPanel>
                    <Button x:Name="NotesToggleButton" Content="Notes &#x25B8;" Click="NotesToggle_Click"
                            AutomationProperties.Name="Expand or collapse speaker notes" DockPanel.Dock="Left" />
                    <TextBlock x:Name="DocumentStatus" Text="New note / no automatic saving" FontSize="11"
                               Foreground="{DynamicResource ThemeMuted}" Margin="8,0" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Grid x:Name="NotesSection" Grid.Row="6" Visibility="Collapsed" Margin="12,4,12,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="140" />
                </Grid.RowDefinitions>
                <WrapPanel x:Name="FileToolbar" IsEnabled="False">
                    <Button Content="New" Click="New_Click" />
                    <Button Content="Open" Click="Open_Click" />
                    <Button Content="Save" Click="Save_Click" />
                    <Button Content="Save as" Click="SaveAs_Click" />
                    <Button Content="Find" Click="Find_Click" />
                    <Button Content="A-" Click="Smaller_Click" AutomationProperties.Name="Smaller note font" />
                    <Button Content="A+" Click="Larger_Click" AutomationProperties.Name="Larger note font" />
                    <CheckBox x:Name="WrapCheck" Content="Wrap" IsChecked="True"
                              VerticalAlignment="Center" Margin="6,0" Click="Wrap_Click" />
                </WrapPanel>
                <StackPanel x:Name="FindPanel" Grid.Row="1" Visibility="Collapsed" Orientation="Horizontal">
                    <TextBox x:Name="FindText" Width="210" Margin="0,4" Padding="5"
                             AutomationProperties.Name="Find in speaker notes" />
                    <Button Content="Next" Click="FindNext_Click" />
                    <Button Content="Close find" Click="CloseFind_Click" />
                </StackPanel>
                <TextBox x:Name="NoteEditor" Grid.Row="2" Padding="7"
                         FontFamily="Consolas" FontSize="18" AcceptsReturn="True" AcceptsTab="True"
                         IsReadOnly="True" Focusable="False"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                         UndoLimit="100" TextChanged="Note_TextChanged" DataObject.Pasting="Note_Pasting"
                         AutomationProperties.Name="Speaker notes" />
            </Grid>
            <StackPanel Grid.Row="7" Margin="12,1,12,8">
                <TextBlock x:Name="StatusText" Text="Initializing capture exclusion..."
                           FontSize="11" Foreground="{DynamicResource ThemeWarning}" TextWrapping="Wrap" />
                <TextBlock Text="Ctrl+Alt+Space: hide/reveal  /  Ctrl+Alt+E: edit notes  /  relaunch: recover"
                           FontSize="10" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
