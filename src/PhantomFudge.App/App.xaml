<Application x:Class="PhantomFudge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="#F0F0EC" />
            <Setter Property="BorderBrush" Value="#CCD0D0" />
            <Setter Property="Foreground" Value="#202B30" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="ContextMenu" Value="{x:Null}" />
            <Setter Property="SpellCheck.IsEnabled" Value="False" />
        </Style>
    </Application.Resources>
</Application>
